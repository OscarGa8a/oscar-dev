---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../i18n/index';
import { homeCopy, homeBase } from '../../i18n/home';
import Heading from './Heading.astro';
import { whatsappUrl, contact } from '../../config/site';
const { lang, n: num = '09' } = Astro.props as { lang: Locale; n?: string };
const c = homeCopy[lang].contact;
const f = homeCopy[lang].footer;
const n = homeCopy[lang].nav;
const base = homeBase(lang);
const year = new Date().getFullYear();
const socials = [
  { href: contact.instagram, label: 'Instagram', icon: 'ph:instagram-logo' },
  { href: contact.tiktok, label: 'TikTok', icon: 'ph:tiktok-logo' },
  { href: contact.linkedin, label: 'LinkedIn', icon: 'ph:linkedin-logo' },
  { href: contact.github, label: 'GitHub', icon: 'ph:github-logo' },
  { href: whatsappUrl(lang), label: 'WhatsApp', icon: 'ph:whatsapp-logo', event: 'whatsapp_click' },
].filter((s) => s.href);
---
<section class="section surface-paper" id="contacto" aria-labelledby="contact-title">
  <span class="contact-ring" aria-hidden="true"></span><span class="contact-art" aria-hidden="true"></span>
  <div class="wrap contact">
    <div>
      <Heading n={num} eyebrow={c.eyebrow} a={c.h2a} b={c.h2b} id="contact-title" />
      <p class="lead" style="margin-top:1.75rem">{c.body}</p>
      <div class="ctas">
        <a class="btn btn-ink" href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-location="final_cta"><Icon name="ph:whatsapp-logo" aria-hidden="true" />{c.cta}</a>
        <a class="btn btn-line" href={contact.email} data-event="email_click" data-event-location="final_cta"><Icon name="ph:envelope-simple" aria-hidden="true" />{c.email}</a>
      </div>
    </div>
  </div>
</section>
<footer class="footer v2">
  <div class="wrap">
    <div class="top">
      <div class="brand"><a href={base} aria-label={n.home}><img src="/logo-oscar-dev.webp" alt="Oscar Dev" width="600" height="108" loading="lazy" /></a><p>{f.tagline}</p></div>
      <nav aria-label="Footer"><ul>
        <li><a href={base}>{f.home}</a></li>
        <li><a href={lang === 'es' ? '/proyectos/' : '/en/projects/'}>{n.projects}</a></li>
        <li><a href={`${base}#servicios`}>{n.services}</a></li>
        <li><a href={lang === 'es' ? '/precios/' : '/en/pricing/'}>{n.pricing}</a></li>
        <li><a href={lang === 'es' ? '/diseno-web-villavicencio/' : '/en/web-design-villavicencio/'}>{f.local}</a></li>
        <li><a href={lang === 'es' ? '/paginas-web-negocios-latinos-usa/' : '/en/hispanic-business-websites/'}>{f.usa}</a></li>
        <li><a href={`${base}#preguntas`}>{f.faq}</a></li>
        <li><a href="mailto:hola@oscardev.co" data-event="email_click" data-event-location="footer">hola@oscardev.co</a></li>
      </ul></nav>
      <ul class="socials" aria-label={f.social}>
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} data-event={s.event ?? 'social_click'} data-event-location="footer"><Icon name={s.icon} aria-hidden="true" /></a></li>)}
      </ul>
    </div>
    <div class="bottom"><span>© {year} Oscar Dev. {f.rights}</span><span>{f.made}</span></div>
  </div>
</footer>
