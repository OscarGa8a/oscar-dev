---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../i18n/index';
import { homeCopy } from '../../i18n/home';
import Heading from './Heading.astro';
import { whatsappUrl } from '../../config/site';
const { lang } = Astro.props as { lang: Locale };
const c = homeCopy[lang].faq;
const cta = homeCopy[lang].contact.cta;
---
<section class="section surface-paper" id="preguntas" aria-labelledby="faq-title">
  <div class="wrap faq">
    <div class="side">
      <Heading n="08" eyebrow={c.eyebrow} a={c.h2a} b={c.h2b} id="faq-title" />
      <p class="lead" style="margin-top:1.5rem">{c.intro}</p>
      <div class="ctas"><a class="btn btn-ink" href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-location="faq">{cta}<Icon name="ph:whatsapp-logo" aria-hidden="true" /></a></div>
    </div>
    <div>
      <ul class="acc" id="faq-acc">
        {c.items.map((it, i) => (
          <li>
            <h3><button type="button" id={`faq-b${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-p${i}`}><span class="n" aria-hidden="true">0{i + 1}</span><span>{it.q}</span><span class="chev" aria-hidden="true"><Icon name="ph:caret-down" /></span></button></h3>
            <div class="panel" id={`faq-p${i}`} role="region" aria-labelledby={`faq-b${i}`} hidden={i !== 0}><p style="margin:0">{it.a}</p></div>
          </li>
        ))}
      </ul>
      <p class="faq-out">{c.outro} <a href="#contacto">{c.outroLink}</a></p>
    </div>
  </div>
</section>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('#faq-acc button');
  btns.forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    btns.forEach((o) => { o.setAttribute('aria-expanded', 'false'); document.getElementById(o.getAttribute('aria-controls')!)!.hidden = true; });
    if (open) { b.setAttribute('aria-expanded', 'true'); document.getElementById(b.getAttribute('aria-controls')!)!.hidden = false; }
  }));
</script>
