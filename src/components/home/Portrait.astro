---
/**
 * Hero portrait. Today there is no real photo, so it renders an intentional editorial card (monogram).
 * To swap in the real photo: add it to src/assets/ and pass it as `src`, e.g.
 *   import oscar from '../../assets/oscar.jpg';  <Portrait src={oscar} ... />
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/index';
interface Props { lang: Locale; alt: string; src?: ImageMetadata }
const { lang, alt, src } = Astro.props;
---
<div class="portrait">
  {src ? (
    <Image class="photo" src={src} alt={alt} widths={[400, 640, 900]} sizes="(min-width:1024px) 34rem, 90vw" loading="eager" fetchpriority="high" />
  ) : (
    <div class="ph-card" aria-hidden="true">
      <span class="ring r1"></span><span class="ring r2"></span>
      <span class="mono">OG</span>
      <span class="cap"><strong>Oscar García</strong><span>{lang === 'es' ? 'Desarrollador web · Villavicencio, CO' : 'Web developer · Villavicencio, CO'}</span></span>
    </div>
  )}
</div>
