---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../i18n/index';
import { homeCopy } from '../../i18n/home';
import { publishedProjects, projectsIndexUrl } from '../../data/projects';
import ProjectCard from './ProjectCard.astro';
import Heading from './Heading.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const c = homeCopy[lang].projects;
---
<section class="section surface-dark" id="proyectos" aria-labelledby="proj-title">
  <div class="wrap proj-head">
    <div><Heading n="02" eyebrow={c.eyebrow} a={c.h2a} b={c.h2b} id="proj-title" /></div>
    <div class="side">
      <p class="lead" style="margin:0">{c.intro}</p>
      <div class="carousel-btns">
        <button type="button" class="prev" aria-label={c.prev} aria-controls="proj-track" disabled><Icon name="ph:arrow-left" aria-hidden="true" /></button>
        <button type="button" class="next" aria-label={c.next} aria-controls="proj-track"><Icon name="ph:arrow-right" aria-hidden="true" /></button>
      </div>
    </div>
  </div>
  <div role="region" aria-roledescription="carousel" aria-label={c.region}>
    <ul class="track" id="proj-track" tabindex="0">
      {publishedProjects.map((p) => (
        <li>
          <ProjectCard p={p} lang={lang} location="projects_carousel" />
        </li>
      ))}
    </ul>
  </div>
  <div class="wrap proj-foot">
    <div class="progress" role="presentation"><i id="proj-progress"></i></div>
    <span class="swipe" aria-hidden="true">{c.swipe}</span>
    <a class="text-link proj-all" href={projectsIndexUrl(lang)}>{c.all}<Icon name="ph:arrow-right" aria-hidden="true" /></a>
  </div>
</section>
<script>
  const track = document.getElementById('proj-track')!;
  const bar = document.getElementById('proj-progress')!;
  const prev = document.querySelector<HTMLButtonElement>('.carousel-btns .prev')!;
  const next = document.querySelector<HTMLButtonElement>('.carousel-btns .next')!;
  const update = () => {
    const max = track.scrollWidth - track.clientWidth;
    const ratio = track.clientWidth / track.scrollWidth;
    const pos = max > 0 ? track.scrollLeft / max : 1;
    bar.style.width = `${(ratio + (1 - ratio) * pos) * 100}%`;
    prev.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft >= max - 2;
  };
  const step = (d: number) => {
    const card = track.querySelector('li') as HTMLElement;
    const gap = parseFloat(getComputedStyle(track).columnGap) || 16;
    track.scrollBy({ left: d * (card.offsetWidth + gap), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  };
  prev.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  track.addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();
</script>
