---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import { Icon } from 'astro-icon/components';
import { whatsappUrl } from '../config/site';
const lang = 'es' as const;
---
<BaseLayout lang={lang} title="Página no encontrada | Oscar Dev" description="La página que buscas no existe. Vuelve al inicio de Oscar Dev." noindex>
  <SiteHeader lang={lang} solid />
  <main id="contenido-principal" class="surface-paper" style="min-height:100svh;display:flex;align-items:center;padding-top:5rem">
    <div class="wrap section" style="overflow:visible">
      <p class="eyebrow"><span class="n">404 /</span><span>Página no encontrada · Page not found</span></p>
      <h1 class="h2" style="font-size:clamp(3rem,9vw,8rem)">Esta página <span class="accent">no existe.</span></h1>
      <p class="lead" style="margin-top:1.5rem">Puede que el enlace esté roto o que la página se haya movido. <span lang="en">The link may be broken or the page may have moved.</span></p>
      <div style="display:flex;flex-wrap:wrap;gap:.85rem;margin-top:2rem">
        <a class="btn btn-ink" href="/">Volver al inicio<Icon name="ph:arrow-right" aria-hidden="true" /></a>
        <a class="btn btn-line" href="/en/" hreflang="en" lang="en">Go to English home</a>
        <a class="btn btn-line" href={whatsappUrl(lang)} target="_blank" rel="noopener noreferrer" data-event="whatsapp_click" data-event-location="404">WhatsApp</a>
      </div>
    </div>
  </main>
</BaseLayout>
