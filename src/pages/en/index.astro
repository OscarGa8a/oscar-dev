---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/home/SiteHeader.astro';
import Hero from '../../components/home/Hero.astro';
import Projects from '../../components/home/Projects.astro';
import Manifesto from '../../components/home/Manifesto.astro';
import Services from '../../components/home/Services.astro';
import Signature from '../../components/home/Signature.astro';
import Method from '../../components/home/Method.astro';
import About from '../../components/home/About.astro';
import Faq from '../../components/home/Faq.astro';
import Contact from '../../components/home/Contact.astro';

const lang = 'en' as const;
---
<BaseLayout lang={lang} title="Web Developer for Small Businesses | Oscar Dev" description="Websites, online stores and booking systems for small businesses in the US and Colombia. Bilingual. Landing pages from USD 200.">
  <SiteHeader lang={lang} />
  <main id="contenido-principal">
    <Hero lang={lang} />
    <Projects lang={lang} />
    <Manifesto lang={lang} />
    <Services lang={lang} />
    <Signature lang={lang} />
    <Method lang={lang} />
    <About lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>
</BaseLayout>
